# ─────────────────────────────────────────────────────────────
#  MONOLITH CREATIONS — Server Builder configuration
#  Copy this file to ".env" and fill in the values.
# ─────────────────────────────────────────────────────────────

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Application (client) ID from the "General Information" page (used for the invite link).
# Optional: the bot fills it in automatically once it logs in.
CLIENT_ID=

# Guild (server) IDs. In Discord: User Settings → Advanced → Developer Mode ON,
# then right-click the server icon → "Copy Server ID".
COMMUNITY_GUILD_ID=
GAME_GUILD_ID=

# Local control panel
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Optional. If set, the panel asks for this password before it does anything.
# Strongly recommended if you change PANEL_HOST to 0.0.0.0.
PANEL_PASSWORD=

# ── Links used inside the template messages (buttons & text). Optional. ──
ROBLOX_GROUP_URL=
BALLOON_PUMP_URL=
# Permanent invite links, so each server can link to the other one.
COMMUNITY_DISCORD_INVITE=
GAME_DISCORD_INVITE=

# Open the control panel in your browser automatically when the bot starts.
OPEN_BROWSER=true
