  "automod": [
    {
      "name": "Block slurs & sexual content",
      "trigger": "KeywordPreset",
      "metadata": {
        "presets": [
          "Profanity",
          "SexualContent",
          "Slurs"
        ]
      },
      "actions": [
        {
          "type": "BlockMessage",
          "message": "Please keep chat friendly — that message was blocked."
        }
      ],
      "exemptRoles": [
        "Founder",
        "Executive",
        "Head Moderator",
        "Moderator",
        "Trial Moderator",
        "Community Manager"
      ]
    },
    {
      "name": "Scam & free Robux links",
      "trigger": "Keyword",
      "metadata": {
        "keywords": [
          "free robux",
          "*robux generator*",
          "robux hack*",
          "*freerobux*",
          "free nitro",
          "*nitro giveaway*",
          "*grabify*",
          "*iplogger*",
          "*rbxflip*",
          "*bloxflip*"
        ]
      },
      "actions": [
        {
          "type": "BlockMessage",
          "message": "Scam / fake-Robux content is not allowed."
        },
        {
          "type": "SendAlertMessage",
          "channel": "mod-log"
        },
        {
          "type": "Timeout",
          "seconds": 600
        }
      ],
      "exemptRoles": [
        "Founder",
        "Executive",
        "Head Moderator",
        "Moderator",
        "Trial Moderator",
        "Community Manager"
      ]
    },
    {
      "name": "Discord invite links",
      "trigger": "Keyword",
      "metadata": {
        "regex": [
          "discord(?:\\.gg|(?:app)?\\.com/invite)/[a-zA-Z0-9-]+"
        ]
      },
      "actions": [
        {
          "type": "BlockMessage",
          "message": "Posting server invites isn't allowed here."
        },
        {
          "type": "SendAlertMessage",
          "channel": "mod-log"
        }
      ],
      "exemptRoles": [
        "Founder",
        "Executive",
        "Head Moderator",
        "Moderator",
        "Trial Moderator",
        "Community Manager",
        "Partner"
      ]
    },
    {
      "name": "Mention spam",
      "trigger": "MentionSpam",
      "metadata": {
        "mentionLimit": 6,
        "raidProtection": true
      },
      "actions": [
        {
          "type": "BlockMessage"
        },
        {
          "type": "SendAlertMessage",
          "channel": "mod-log"
        },
        {
          "type": "Timeout",
          "seconds": 600
        }
      ],
      "exemptRoles": [
        "Founder",
        "Executive",
        "Head Moderator",
        "Moderator",
        "Trial Moderator",
        "Community Manager"
      ]
    },
    {
      "name": "Spam filter",
      "trigger": "Spam",
      "actions": [
        {
          "type": "BlockMessage"
        },
        {
          "type": "SendAlertMessage",
          "channel": "mod-log"
        }
      ],
      "exemptRoles": [
        "Founder",
        "Executive",
        "Head Moderator",
        "Moderator",
        "Trial Moderator",
        "Community Manager"
      ]
    }
  ],
